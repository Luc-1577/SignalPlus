<?xml version="1.0" encoding="utf-8"?>
<!-- Governa backup em nuvem e transferência device-to-device em API 31+
     (API 23-30 usa backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- exports/ (filesDir) pode conter CSVs com dados de localização/torre
             (ver TowerPositionRepository) — diferente de cacheDir (sempre
             excluído por padrão), filesDir É incluído no backup por padrão. -->
        <exclude domain="file" path="exports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="exports/" />
    </device-transfer>
</data-extraction-rules>